{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ouroboric-dev/gungnir/schema/disputes.schema.json",
  "title": "an implementer's disputes",
  "description": "An implementer's dispute of open findings, each settled by a named check of the loop that passed and printed the test (change disputed-findings). An empty list says it disputes nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["disputes"],
  "properties": {
    "disputes": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/dispute" } }
  },
  "$defs": {
    "dispute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check", "test", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "check": { "type": "string", "minLength": 1, "maxLength": 100 },
        "test": { "type": "string", "minLength": 1, "maxLength": 300 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 1500 }
      }
    }
  }
}

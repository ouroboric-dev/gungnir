{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ouroboric-dev/gungnir/schema/implement.schema.json",
  "title": "ygg.implement/v1",
  "description": "The implementer's answer: what it did, and the open findings it disputes, each settled by a named check of the loop: a dispute holds when the check's typed result for that attempt lists the test among passed_tests and not among its failures (change disputed-findings). A blocked answer ends the attempt. With blocked, the summary is optional.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "description": "What the implementer did.",
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "disputes": {
      "description": "The open findings the implementer disputes. An empty list disputes nothing.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/dispute"
      }
    },
    "blocked": {
      "$ref": "#/$defs/blocked"
    },
    "notes": {
      "$ref": "#/$defs/notes"
    }
  },
  "if": {
    "required": [
      "blocked"
    ]
  },
  "then": {},
  "else": {
    "required": [
      "summary"
    ]
  },
  "$defs": {
    "blocked": {
      "description": "The session could not do its work, and says why.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    },
    "notes": {
      "description": "Anything the schema did not foresee.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "dispute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "check",
        "test",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "check": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "test": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        }
      }
    }
  }
}

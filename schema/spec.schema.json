{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ouroboric-dev/gungnir/schema/spec.schema.json",
  "title": "ygg.spec/v1",
  "description": "The spec stage's answer: the sections of the engineering spec as fields, and the leaves. Odin renders the spec document and leaves.yaml. With blocked, the content fields are optional.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "description": "The product's name.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "slug": {
      "description": "The design's slug.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+){0,3}$"
    },
    "summary": {
      "description": "Summary.",
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "architecture": {
      "description": "Architecture and components.",
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "interfaces": {
      "description": "Interfaces and contracts.",
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "data_model": {
      "description": "Data model.",
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "acceptance_criteria": {
      "description": "Acceptance criteria per feature.",
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "security": {
      "description": "Security considerations.",
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "testing": {
      "description": "Testing approach.",
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "decisions": {
      "description": "The decisions the spec makes.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/decided"
      }
    },
    "deviations": {
      "description": "Where the design cannot be built as written.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/deviation"
      }
    },
    "leaves": {
      "description": "The product's leaves, as leaves.yaml holds them.",
      "$ref": "leaves.schema.json"
    },
    "blocked": {
      "$ref": "#/$defs/blocked"
    },
    "notes": {
      "$ref": "#/$defs/notes"
    }
  },
  "if": {
    "required": [
      "blocked"
    ]
  },
  "then": {},
  "else": {
    "required": [
      "title",
      "slug",
      "summary",
      "architecture",
      "interfaces",
      "data_model",
      "acceptance_criteria",
      "security",
      "testing",
      "decisions",
      "deviations",
      "leaves"
    ]
  },
  "$defs": {
    "blocked": {
      "description": "The session could not do its work, and says why.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    },
    "notes": {
      "description": "Anything the schema did not foresee.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "cites": {
      "description": "Owner decision ids this one comes from.",
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "decided": {
      "description": "One '**Decided <date>:** <decision>. <reason>.' line.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "decision",
        "reason"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "decision": {
          "description": "What was decided.",
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "reason": {
          "description": "Why.",
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "cites": {
          "$ref": "#/$defs/cites"
        }
      }
    },
    "deviation": {
      "description": "A point where the design cannot be built as written.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "what",
        "where",
        "why"
      ],
      "properties": {
        "what": {
          "description": "What differs.",
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "where": {
          "description": "Where in the design.",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "why": {
          "description": "Why.",
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "cites": {
          "$ref": "#/$defs/cites"
        }
      }
    }
  }
}

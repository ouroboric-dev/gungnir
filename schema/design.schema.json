{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ouroboric-dev/gungnir/schema/design.schema.json",
  "title": "ygg.design/v1",
  "description": "The design stage's answer: the sections of the design doc as fields. Odin renders the document. With blocked, the content fields are optional.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "description": "The product's name.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "slug": {
      "description": "One to four words of the name, lower case, joined by dashes.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+){0,3}$"
    },
    "summary": {
      "description": "What the product is, for whom, in four sentences at most.",
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "goals": {
      "description": "The goals.",
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "non_goals": {
      "description": "The non-goals, each with its reason.",
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "success_criteria": {
      "description": "Criteria a person could check by using the product.",
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "context": {
      "description": "Who the users are, what they do today, the limits, and what was assumed.",
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "product_at_user_level": {
      "description": "What each kind of user can do, step by step, and what happens when things go wrong.",
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "decisions": {
      "description": "The decisions the design makes.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/decided"
      }
    },
    "open_questions": {
      "description": "What a person should decide, each with an id.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "blocked": {
      "$ref": "#/$defs/blocked"
    },
    "notes": {
      "$ref": "#/$defs/notes"
    }
  },
  "if": {
    "required": [
      "blocked"
    ]
  },
  "then": {},
  "else": {
    "required": [
      "title",
      "slug",
      "summary",
      "goals",
      "non_goals",
      "success_criteria",
      "context",
      "product_at_user_level",
      "decisions",
      "open_questions"
    ]
  },
  "$defs": {
    "blocked": {
      "description": "The session could not do its work, and says why.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    },
    "notes": {
      "description": "Anything the schema did not foresee.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "cites": {
      "description": "Owner decision ids this one comes from.",
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "decided": {
      "description": "One '**Decided <date>:** <decision>. <reason>.' line.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "decision",
        "reason"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "decision": {
          "description": "What was decided.",
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "reason": {
          "description": "Why.",
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "cites": {
          "$ref": "#/$defs/cites"
        }
      }
    },
    "question": {
      "description": "An open question.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "who_can_answer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q[0-9]{1,3}$"
        },
        "question": {
          "description": "The question.",
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "who_can_answer": {
          "description": "Who could answer it.",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}

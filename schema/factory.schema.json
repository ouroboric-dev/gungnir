{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ouroboric-dev/gungnir/schema/factory.schema.json",
  "title": "factory.yaml",
  "description": "The operator's factory settings: mode, approval-point overrides, roles, budget caps and privacy (spec §5, §7; change require-budget-caps). Caps are required and have no defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": ["roles", "budget"],
  "properties": {
    "mode": { "enum": ["step-by-step", "key-points", "unattended"] },
    "gates": {
      "type": "object",
      "propertyNames": {
        "enum": ["design", "spec", "plan", "feature", "merge", "pointer", "pointer-contract", "escalation",
                 "deploy-prod", "store-submit", "real-secrets-or-user-data", "budget-cap",
                 "external-input", "policy-violation", "shrink-guard", "guardrail-change",
                 "repo-admin"]
      },
      "additionalProperties": { "enum": ["stop", "auto"] }
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/role" }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_run", "per_day"],
      "properties": {
        "per_run": { "$ref": "#/$defs/cap" },
        "per_day": { "$ref": "#/$defs/cap" },
        "journal": { "type": "string", "minLength": 1, "description": "an absolute folder where every run of this operator records its spend, which the per-day cap sums; empty: $XDG_STATE_HOME/ygg/spend or ~/.local/state/ygg/spend" }
      }
    },
    "privacy": { "enum": ["standard", "strict"] },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine"],
      "properties": {
        "engine": { "type": "string", "pattern": "^unix:///[^ ]+$", "description": "the container engine's socket; the factory never reads CONTAINER_HOST" },
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "engine"],
            "properties": { "host": { "type": "string" }, "engine": { "type": "string" } }
          }
        }
      }
    },
    "realms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir"],
      "properties": { "dir": { "type": "string", "minLength": 1, "description": "an absolute folder with one checkout of each realm leaf, so --realm midgard-react finds <dir>/midgard-react" } }
    },
    "graphs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir"],
      "properties": { "dir": { "type": "string", "minLength": 1, "description": "an absolute folder with one graph pack per graph, so --graph software finds <dir>/software/pack.yaml" } }
    },
    "grader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks_dir", "suite_dir", "timeout", "memory", "cpus"],
      "properties": {
        "tasks_dir": { "type": "string", "minLength": 1, "description": "an absolute folder: a checkout of the task repo, <dir>/<task id>/{task.toml,instruction.md,environment/}" },
        "suite_dir": { "type": "string", "minLength": 1, "description": "an absolute folder: the store of hidden suites, <dir>/<task id>/<suite>/tests/; never mounted into an agent's sandbox" },
        "timeout": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" },
        "memory": { "type": "string", "pattern": "^([1-9][0-9]*[mg]|none)$", "description": "the container's memory limit, such as 4g; none asks for no limit, for an engine that cannot apply one (rootless Podman with no cgroup delegation)" },
        "cpus": { "type": "integer", "minimum": 0, "maximum": 256, "description": "the container's CPUs; 0 asks for no limit, as memory: none does" }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "private_dir": { "type": "string", "minLength": 1 } }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "model"],
      "properties": {
        "agent": { "enum": ["claude-code", "opencode", "scripted"] },
        "model": { "type": "string", "minLength": 1 },
        "script": { "type": "string", "minLength": 1 },
        "price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output"],
          "properties": {
            "input": { "type": "number", "minimum": 0 },
            "output": { "type": "number", "minimum": 0 },
            "cache_read": { "type": "number", "minimum": 0 },
            "cache_write": { "type": "number", "minimum": 0 }
          }
        }
      },
      "if": { "properties": { "agent": { "const": "scripted" } } },
      "then": { "required": ["script"] },
      "else": { "not": { "required": ["script"] } }
    },
    "cap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "turns"],
      "properties": {
        "tokens": { "type": "integer", "minimum": 1 },
        "turns": { "type": "integer", "minimum": 1 },
        "usd": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
